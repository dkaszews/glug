PROJECT_NAME = "glug"
INPUT = include README.md LICENSE.md
RECURSIVE = yes
EXCLUDE = include/glug/backport include/glug/generated
EXCLUDE_PATTERNS =
EXCLUDE_SYMBOLS =
IMPLICIT_DIR_DOCS = no
OUTPUT_DIRECTORY = build/docs
STRIP_FROM_INC_PATH = include/glug
STRIP_FROM_PATH = include/glug
USE_MDFILE_AS_MAINPAGE = README.md

BUILTIN_STL_SUPPORT = yes
CASE_SENSE_NAMES = yes
HIDE_FRIEND_COMPOUNDS = yes
HIDE_UNDOC_NAMESPACES = no
INLINE_INFO = no
JAVADOC_AUTOBRIEF = yes
MULTILINE_CPP_IS_BRIEF = yes
PYTHON_DOCSTRING = no
QT_AUTOBRIEF = yes
STRIP_CODE_COMMENTS = no

WARNINGS = yes
WARN_AS_ERROR = fail_on_warnings
WARN_IF_DOC_ERROR = yes
WARN_IF_INCOMPLETE_DOC = yes
WARN_IF_UNDOCUMENTED = yes
WARN_IF_UNDOC_ENUM_VAL = yes
WARN_LAYOUT_FILE = yes
WARN_NO_PARAMDOC = yes

REFERENCED_BY_RELATION = yes
REFERENCES_LINK_SOURCE = yes
REFERENCES_RELATION = yes

CLANG_ASSISTED_PARSING = yes
CLANG_DATABASE_PATH = compile_commands.json

GENERATE_LATEX = no

GENERATE_HTML = yes
HTML_CODE_FOLDING = yes
HTML_COLORSTYLE = AUTO_LIGHT
HTML_COLORSTYLE_GAMMA = 80
HTML_COLORSTYLE_HUE = 220
HTML_COLORSTYLE_SAT = 100
HTML_COPY_CLIPBOARD = yes
HTML_DYNAMIC_MENUS = yes
HTML_DYNAMIC_SECTIONS = yes
HTML_EXTRA_STYLESHEET = build/docs/html/doxygen-awesome.css

